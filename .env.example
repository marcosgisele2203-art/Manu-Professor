# Conexão com o Postgres (no EasyPanel, copie a "Internal Connection URL" do serviço Postgres)
DATABASE_URL="postgresql://postgres:senha@localhost:5432/caderno"
# Segredo para assinar o login. Gere com: openssl rand -hex 32
AUTH_SECRET="troque-por-um-valor-aleatorio-longo"
# Chave da API da Anthropic (console.anthropic.com) para as funções de IA
ANTHROPIC_API_KEY=""
# E-mails dos administradores (veem o painel em /admin), separados por vírgula
ADMIN_EMAILS=""
# Quantos pedidos de IA cada professor pode fazer por mês (padrão 60)
LIMITE_IA_MENSAL="60"
# E-mail de contato mostrado na página de privacidade (opcional)
CONTATO_EMAIL=""
# ID do cliente OAuth do Google (opcional) para o botão "Salvar no Google Drive".
# Não é segredo: é o "ID do cliente" do tipo Aplicativo da Web criado no Google Cloud.
GOOGLE_CLIENT_ID=""
# Chave secreta do mesmo cliente OAuth. Com ela aparece o botão "Continuar com Google"
# e a permissão do Drive fica guardada no cadastro do professor. É segredo: só no EasyPanel.
GOOGLE_CLIENT_SECRET=""
